{
  "name": "@upmo-ai/theme",
  "version": "1.2.0",
  "description": "The Mantine 9 theme for Upmo, built from @upmo-ai/tokens. Exports the theme object, the CSS-variables resolver that maps Mantine onto Upmo tokens, and the color-scheme wiring.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "homepage": "https://design.upmo.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upmo-ai/design-system.git",
    "directory": "packages/theme"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup"
  },
  "peerDependencies": {
    "@mantine/core": "^9.7.4"
  },
  "dependencies": {
    "@upmo-ai/tokens": "workspace:1.2.0"
  },
  "devDependencies": {
    "@mantine/core": "^9.7.4",
    "tsup": "^8.3.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
