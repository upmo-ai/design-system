{
  "name": "@upmo-ai/components",
  "version": "1.6.0",
  "description": "The Upmo React component library: real, themed, accessible Mantine 9 components built on Upmo tokens.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "homepage": "https://design.upmo.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upmo-ai/design-system.git",
    "directory": "packages/components"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dates": {
      "types": "./dist/dates.d.ts",
      "default": "./dist/dates.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "peerDependencies": {
    "@mantine/core": "^9.7.4",
    "@mantine/dates": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@tabler/icons-react": "^3.0.0",
    "@upmo-ai/brands": "workspace:1.6.0",
    "@upmo-ai/icons": "workspace:1.6.0",
    "@upmo-ai/theme": "workspace:1.6.0",
    "dayjs": ">=1.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@mantine/dates": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "echarts": "6.1.0",
    "prism-react-renderer": "^2.4.1"
  },
  "devDependencies": {
    "@mantine/core": "^9.7.4",
    "@mantine/dates": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@storybook/react-vite": "^10.6.5",
    "@tabler/icons-react": "^3.50.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@upmo-ai/brand": "workspace:1.6.0",
    "@upmo-ai/brands": "workspace:1.6.0",
    "@upmo-ai/icons": "workspace:1.6.0",
    "@upmo-ai/theme": "workspace:1.6.0",
    "@upmo-ai/tokens": "workspace:1.6.0",
    "axe-core": "4.10.3",
    "dayjs": "^1.11.23",
    "esbuild": "0.27.7",
    "jsdom": "^26.0.0",
    "playwright-core": "1.61.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.3.5"
  },
