{
  "name": "@upmo-ai/tokens",
  "version": "1.6.1",
  "description": "Upmo design tokens: CSS variables for the light, dark and high-contrast themes, and a typed object of every value.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "homepage": "https://design.upmo.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upmo-ai/design-system.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./fonts.css": "./dist/fonts.css"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepare": "node scripts/build.ts"
  },
  "devDependencies": {
    "@fontsource/familjen-grotesk": "5.3.0",
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/manrope": "5.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
