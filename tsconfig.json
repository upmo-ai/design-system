{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["packages/tokens/src", "packages/tokens/scripts", "packages/tokens/test", "packages/theme/src", "packages/theme/test", "packages/icons/scripts", "packages/brands/scripts", "packages/brand/src", "packages/brand/scripts", "packages/brand/test", "scripts"],
  "exclude": ["**/dist", "**/node_modules", "packages/components"]
}
