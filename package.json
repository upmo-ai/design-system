{
  "name": "upmo-design-system",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @upmo-ai/docs dev",
    "gen": "pnpm --filter @upmo-ai/docs gen",
    "test": "vitest run",
    "lint": "node scripts/check-hex.ts && node scripts/check-terms.ts && tsc -p tsconfig.json && pnpm --filter @upmo-ai/docs lint"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
